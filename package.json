{
	"name": "recetas-frontend",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": ">=24 <25"
	},
	"packageManager": "pnpm@12.11.2",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node build",
		"prepare": "(svelte-kit sync && pnpm run --silent i18n:compile) || echo ''",
		"check": "svelte-kit sync && pnpm run --silent i18n:compile && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint . && prettier --check . && pnpm run --silent check:strings && pnpm run --silent check:colors",
		"lint:actions": "docker run --rm -u \"$(id -u):$(id -g)\" -v \"$PWD\":/work -w /work rhysd/actionlint:1.7.12@sha256:b1934ee5f1c509618f2508e6eb47ee0d3520686341fec936f3b79331f9315667 -color",
		"format": "prettier --write .",
		"test": "vitest run --passWithNoTests",
		"test:coverage": "vitest run --coverage",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"test:e2e:install": "playwright install --with-deps chromium webkit firefox",
		"lhci:mobile": "lhci autorun --config=lighthouserc.js",
		"lhci:desktop": "lhci autorun --config=lighthouserc.js --collect.settings.preset=desktop --upload.outputDir=.lighthouseci/desktop",
		"tokens:check": "node scripts/check-tokens.ts",
		"map-grid:check": "node scripts/check-map-grid.ts",
		"map-grid:sync": "node scripts/check-map-grid.ts --sync",
		"strings:import": "node scripts/import-strings.ts ../design/design_handoff_asadorov_desktop/strings.json src/lib/i18n/extra-strings.json messages && prettier --write messages",
		"i18n:compile": "paraglide-js compile --project ./project.inlang --silent",
		"check:strings": "node scripts/check-strings.ts",
		"check:colors": "node scripts/check-colors.ts",
		"api:sync": "node scripts/api-sync.ts",
		"api:check": "node scripts/api-check.ts"
	},
	"devDependencies": {
		"@axe-core/playwright": "~4.13.0",
		"@eslint/js": "^10.0.1",
		"@fontsource/archivo": "~5.3.0",
		"@fontsource/cormorant-garamond": "~5.3.0",
		"@fontsource/golos-text": "~5.3.0",
		"@fontsource/instrument-serif": "~5.3.0",
		"@inlang/paraglide-js": "2.25.4",
		"@inlang/plugin-message-format": "4.5.4",
		"@lhci/cli": "0.15.1",
		"@lucide/svelte": "~1.52.0",
		"@opentelemetry/exporter-trace-otlp-proto": "~0.223.0",
		"@opentelemetry/resources": "~2.12.0",
		"@opentelemetry/sdk-trace-node": "~2.12.0",
		"@opentelemetry/semantic-conventions": "~1.43.0",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^4.1.11",
		"@vitest/coverage-v8": "^4.1.11",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"openapi-fetch": "~0.17.0",
		"openapi-typescript": "~7.13.0",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.11",
		"vitest-browser-svelte": "^2.1.1"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@opentelemetry/api": "~1.9.1"
	}
}
